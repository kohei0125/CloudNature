# アナリティクス
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
# Ahrefs Web Analytics のデータキー（Ahrefs > Web Analytics のタグから取得）
NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=

# クラウドフレア
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# 本番URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 本番orそれ以外 (development / staging / production)
NEXT_PUBLIC_ENV=development

# メール送信
RESEND_API_KEY=
EMAIL_FROM=
NOTIFY_EMAIL=

# Notion連携
NOTION_API_KEY=
NOTION_DATABASE_ID=

# お問い合わせの営業仕分け（docs/20260920_contact_sales_triage_review.md）
# 判定は Vercel AI Gateway の評価モデル（typesafe-ai/jev）を使う。
# Vercelのデプロイ環境と `vercel env pull` 済みのローカルでは VERCEL_OIDC_TOKEN が
# 自動で入るため、通常このキーの設定は不要。Vercel以外で動かす場合だけ設定する
AI_GATEWAY_API_KEY=
# 仕分けのモデル。省略時は typesafe-ai/jev を使用
AI_GATEWAY_TRIAGE_MODEL=

# microCMS
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# リアルタイム翻訳 (OpenAI Realtime API)
OPEN_AI_REALTIME_TRANSLATE_API_KEY=

# リアルタイム翻訳のゲートパスワード（本番は Vercel 側で新しい値を設定すること）
REALTIME_TRANSLATE_PASSWORD=
